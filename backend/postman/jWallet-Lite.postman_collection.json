{
  "info": {
    "name": "jWallet Lite Mock API",
    "description": "Mock REST API for the jWallet Lite Flutter app. Run **Auth > Login** first: it stores the access token in the `accessToken` collection variable used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "lastTransactionId", "value": "TXN10001" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@jstack.co\",\n  \"password\": \"Demo@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - invalid credentials (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@jstack.co\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - validation error (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "User & Wallet",
      "item": [
        {
          "name": "Get profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/profile" }
        },
        {
          "name": "Get wallet balance",
          "request": { "method": "GET", "url": "{{baseUrl}}/wallet/balance" }
        },
        {
          "name": "Get wallet balance - invalid token (401)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "invalid_token", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/wallet/balance"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "type", "value": "DEBIT", "description": "CREDIT or DEBIT", "disabled": true },
                { "key": "search", "value": "rahul", "description": "Matches reference or beneficiary name", "disabled": true },
                { "key": "from", "value": "2026-11-01T00:00:00Z", "description": "ISO-8601, inclusive", "disabled": true },
                { "key": "to", "value": "2026-11-30T23:59:59Z", "description": "ISO-8601, inclusive", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Recent transactions (dashboard, latest 5)",
          "request": { "method": "GET", "url": "{{baseUrl}}/transactions?limit=5" }
        },
        {
          "name": "Get transaction details",
          "request": { "method": "GET", "url": "{{baseUrl}}/transactions/{{lastTransactionId}}" }
        },
        {
          "name": "Get transaction details - not found (404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/transactions/TXN99999" }
        },
        {
          "name": "Transfer money",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New key per send. Use 'Transfer money - replay same key' to resend with this key.",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('lastTransactionId', body.data.transactionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beneficiaryName\": \"Rahul Sharma\",\n  \"mobileNumber\": \"9876543210\",\n  \"amount\": 1500.00,\n  \"remarks\": \"Payment for services\"\n}"
            },
            "url": "{{baseUrl}}/transactions/transfer"
          }
        },
        {
          "name": "Transfer money - replay same key (no double deduction)",
          "request": {
            "description": "Resends the last transfer with the same Idempotency-Key and payload. Returns the original result with header `Idempotent-Replayed: true`; the balance is not deducted again.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beneficiaryName\": \"Rahul Sharma\",\n  \"mobileNumber\": \"9876543210\",\n  \"amount\": 1500.00,\n  \"remarks\": \"Payment for services\"\n}"
            },
            "url": "{{baseUrl}}/transactions/transfer"
          }
        },
        {
          "name": "Transfer money - insufficient balance (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beneficiaryName\": \"Rahul Sharma\",\n  \"mobileNumber\": \"9876543210\",\n  \"amount\": 999999\n}"
            },
            "url": "{{baseUrl}}/transactions/transfer"
          }
        },
        {
          "name": "Transfer money - validation errors (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beneficiaryName\": \"\",\n  \"mobileNumber\": \"12345\",\n  \"amount\": -10\n}"
            },
            "url": "{{baseUrl}}/transactions/transfer"
          }
        }
      ]
    },
    {
      "name": "Dev tools",
      "item": [
        {
          "name": "Reset mock data",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/dev/reset" }
        },
        {
          "name": "Simulate server error (500)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Simulate-Error", "value": "500" }],
            "url": "{{baseUrl}}/wallet/balance"
          }
        }
      ]
    }
  ]
}
