# Copy to .env and adjust as needed:  cp .env.example .env

# 0.0.0.0 makes the API reachable from emulators and physical devices on the same Wi-Fi
HOST=0.0.0.0
PORT=3000

# Static mock bearer token returned by /auth/login and required by protected endpoints
MOCK_ACCESS_TOKEN=mock_access_token_123

# Artificial latency (ms) added to every API response, useful to demo loading states
MOCK_DELAY_MS=600

# Enables /api/v1/dev/* helpers (reset data) and the X-Simulate-Error header
ENABLE_DEV_ROUTES=true
